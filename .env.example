# ─── Supabase ────────────────────────────────────────────────────────────────
# Leave every value blank to run without a database: submissions still succeed
# and are written to .data/leads.json plus the server log. See lib/leads.ts.
#
# Create the table first by running supabase/schema.sql in the SQL editor.

SUPABASE_URL=
# Server-only. Bypasses row level security. Never expose this to the browser
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to the service role key: the anon key relies on the insert-only
# policy in supabase/schema.sql. Use one pair or the other, not both.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Lead notification ───────────────────────────────────────────────────────
# Where new consultation requests should be emailed. Defaults to info@arkan.co.
LEAD_NOTIFICATION_TO=

# Email is sent with Resend (lib/notify.ts). Leave both blank to skip sending:
# the notification is logged to the server instead and the lead is still saved.
#
# Key:  https://resend.com/api-keys  — starts with re_, server-only, never
#       commit it.
RESEND_API_KEY=
# Sender address. The domain must be verified at https://resend.com/domains or
# Resend rejects the send. "Arkan Website <website@arkan.co>" is the intended
# production value; use onboarding@resend.dev to test before the domain is set up.
RESEND_FROM=

# ─── AI assistant ────────────────────────────────────────────────────────────
# Leave blank to run the site without the assistant: /consultant then shows a
# short unavailable notice and the consultation form is unaffected.
#
# REQUIRED, unlike for the website form. Assistant tables have RLS enabled with
# no policies, so the publishable key reaches nothing. Server-only.
# SUPABASE_SERVICE_ROLE_KEY is read from the Supabase block above.
#
# Generation. One key reaches every model; switching model is a slug change in
# the model_config table, never a key change. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Embeddings. OpenRouter does not serve embeddings, so this is separate. The
# active provider and model live in the embedding_config table; this key must
# match embedding_config.provider. https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Used only for OpenRouter dashboard attribution. Defaults to https://arkan.co.
SITE_URL=

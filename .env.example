# ─── Supabase ────────────────────────────────────────────────────────────────
# Leave every value blank to run without a database: submissions still succeed
# and are written to .data/leads.json plus the server log. See lib/leads.ts.
#
# Create the table first by running supabase/schema.sql in the SQL editor.

SUPABASE_URL=
# Server-only. Bypasses row level security. Never expose this to the browser
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to the service role key: the anon key relies on the insert-only
# policy in supabase/schema.sql. Use one pair or the other, not both.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Lead notification ───────────────────────────────────────────────────────
# Where new consultation requests should be emailed. Defaults to info@arkan.co.
LEAD_NOTIFICATION_TO=

# Email is sent with Resend (lib/notify.ts). Leave both blank to skip sending:
# the notification is logged to the server instead and the lead is still saved.
#
# Key:  https://resend.com/api-keys  — starts with re_, server-only, never
#       commit it.
RESEND_API_KEY=
# Sender address. The domain must be verified at https://resend.com/domains or
# Resend rejects the send. "Arkan Website <website@arkan.co>" is the intended
# production value; use onboarding@resend.dev to test before the domain is set up.
RESEND_FROM=

# ─── AI assistant ────────────────────────────────────────────────────────────
# The assistant's tables have row level security enabled with no policies, so
# the publishable key reaches none of them. SUPABASE_SERVICE_ROLE_KEY above is
# optional for the website form but REQUIRED here.

# Generation. Every response model is reached through OpenRouter, so one key
# covers Claude, Gemini, GPT and Qwen alike and switching model is a slug
# change in the admin panel. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shown on the OpenRouter dashboard so the spend is attributable. Optional.
NEXT_PUBLIC_SITE_URL=

# Embeddings. OpenRouter does not proxy these, so the active provider needs its
# own key. Only the one selected in the admin panel has to be set; the shipped
# default is OpenAI text-embedding-3-large at 1536 dimensions.
OPENAI_API_KEY=
COHERE_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# Telegram. The webhook is registered from the admin panel; the secret is sent
# back by Telegram in a header on every update and is what proves the request
# came from Telegram and not from someone who guessed the URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Sign-in is a Supabase Auth magic link, so the publishable pair above must be
# set as well. Add this deployment's /admin/auth/callback to the redirect
# allowlist in Authentication → URL Configuration, or every link will be
# refused.

# The first owner. `admin_users` starts empty and nothing can add a row to it
# without a signed-in owner, so this address is let in once — and only while
# that table is still empty. After the first sign-in the variable does nothing,
# which means leaving it set is not a way back in.
ADMIN_BOOTSTRAP_EMAIL=

# ─── Blog pipeline (multi-agent) ─────────────────────────────────────────────
# The eight agents reach every model through the same OPENROUTER_API_KEY above.
# Changing a model is a slug change, never a key or a code path.

# Default model for every agent. Leave blank for google/gemini-2.5-flash.
PIPELINE_MODEL=
# A stronger model for the writer only — the one agent whose output a human
# reads. Leave blank to use PIPELINE_MODEL. e.g. anthropic/claude-sonnet-4.5
WRITER_MODEL=

# Real web search for the researcher. https://tavily.com
# Without it the researcher works from the model's own knowledge and every fact
# it produces is marked as unsourced judgement rather than as a statistic.
TAVILY_API_KEY=

# Password for /studio. Leave blank on a laptop; set it for any deployment that
# is reachable from the internet — the studio can publish.
STUDIO_PASSWORD=

# Protects /api/cron/weekly. Vercel sends it as `Authorization: Bearer <value>`
# on scheduled invocations. With it unset the weekly run is disabled rather than
# left open: the endpoint spends money.
CRON_SECRET=

# Storage: the pipeline uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# With neither set it runs entirely in memory, which is fine on a laptop and
# useless on Vercel — serverless instances do not share memory. Apply
# supabase/blog.sql before deploying.
